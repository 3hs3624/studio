#!/bin/sh
set -eu
port="${PORT:-10000}"
case "$port" in
    ''|*[!0-9]*) echo 'PORT must be numeric.' >&2; exit 1 ;;
esac
python manage.py migrate --noinput
python manage.py bootstrap_local_access --password-prefix STUDIO_LOCAL_
exec gunicorn config.wsgi:application --bind "0.0.0.0:$port" --workers 2 --timeout 60 --access-logfile - --error-logfile -
